# Копируйте этот файл в .env и заполните настоящими значениями

# Окружение
NODE_ENV=development

# Сервер
PORT=8080
FRONTEND_URL=http://localhost:5173

# HH.ru API credentials
HH_CLIENT_ID=your_client_id_here
HH_CLIENT_SECRET=your_client_secret_here
HH_REDIRECT_URI=http://localhost:8080/callback

# JWT secret (используйте длинную случайную строку)
JWT_SECRET=your_jwt_secret_here_minimum_32_characters_long

# Encryption key (32 символа для AES-256)
ENCRYPTION_KEY=your_encryption_key_32_chars_long

# База данных
DATABASE_URL="file:./dev.db"

# Логи
LOG_LEVEL=info
