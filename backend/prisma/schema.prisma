// Prisma Schema для HH Auto-Responder

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Пользователь
model User {
  id        String   @id @default(uuid())
  email     String?  @unique

  // HH.ru данные
  hhUserId  String?  @unique
  accessToken    String?  // Зашифрованный
  refreshToken   String?  // Зашифрованный
  tokenExpiresAt DateTime?

  // Подписка
  subscriptionTier String @default("free") // free, basic, pro, ultimate
  subscriptionExpiresAt DateTime?
  dailyResponsesLimit Int @default(20)
  responsesToday Int @default(0)
  lastResetDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Отношения
  resumes    Resume[]
  settings   Settings?
  applications JobApplication[]
  analytics  Analytics[]
  vacancyViews VacancyView[]
  vacancyFavorites VacancyFavorite[]
  searchHistory SearchHistory[]
  applicationDrafts ApplicationDraft[]
  sessions Session[]
  auditLogs AuditLog[]
  subscriptions Subscription[]
}

// Резюме пользователя
model Resume {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  hhResumeId String?  @unique  // ID резюме в HH.ru
  title      String
  fileUrl    String?
  content    String?  // JSON с данными резюме

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Отношения
  applications JobApplication[]
}

// Настройки автоматической рассылки
model Settings {
  id       String   @id @default(uuid())
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Настройки откликов
  enabled             Boolean @default(false)
  maxResponsesPerDay  Int     @default(200)

  // Фильтры поиска (JSON)
  searchFilters       String?  // {text, area, salary, experience, schedule}
  excludeKeywords     String?  // Исключить вакансии с этими словами
  blacklistEmployers  String?  // ID работодателей в черном списке

  // Сопроводительное письмо
  coverLetterTemplate String?
  useAiGeneration     Boolean @default(false)

  // Расписание
  scheduleEnabled     Boolean @default(false)
  scheduleTime        String?  // JSON массив времен отправки

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Вакансия
model Job {
  id          String   @id @default(uuid())
  hhJobId     String   @unique  // ID вакансии в HH.ru

  title       String
  company     String
  salary      String?
  location    String?
  url         String
  description String?

  // Метаданные
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  // Отношения
  applications JobApplication[]
  views VacancyView[]
  favorites VacancyFavorite[]
}

// Отклик на вакансию
model JobApplication {
  id       String   @id @default(uuid())

  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId    String
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  resumeId String
  resume   Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  // Данные отклика
  status         String  @default("sent")  // sent, viewed, invited, rejected
  letterContent  String?

  // Метаданные
  sentAt     DateTime @default(now())
  viewedAt   DateTime?
  respondedAt DateTime?

  @@unique([userId, jobId])  // Один отклик на вакансию от пользователя
}

// Аналитика
model Analytics {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date      DateTime @default(now())

  // Метрики
  responsesCount   Int @default(0)
  viewsCount       Int @default(0)
  invitationsCount Int @default(0)
  rejectionsCount  Int @default(0)

  @@unique([userId, date])
}

// История просмотров вакансий
model VacancyView {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  viewedAt  DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId, viewedAt])
}

// Избранные вакансии
model VacancyFavorite {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  addedAt   DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId, addedAt])
}

// История поиска
model SearchHistory {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Параметры поиска (JSON)
  text      String?
  area      String?
  salary    Int?
  experience String?
  schedule  String?

  // Метаданные
  name      String?  // Название сохраненного поиска (опционально)
  resultCount Int?   // Количество найденных вакансий
  useCount  Int     @default(1)  // Счетчик использований

  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId, lastUsedAt])
}

// Черновики откликов
model ApplicationDraft {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Данные вакансии
  vacancyId String
  vacancyTitle String
  vacancyCompany String
  vacancyUrl String

  // Данные черновика
  resumeId  String?
  message   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// Сессии пользователя
model Session {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Данные сессии
  token     String   @unique
  ipAddress String?
  userAgent String?
  deviceInfo String? // JSON с информацией об устройстве
  location  String?  // Город/страна

  createdAt DateTime @default(now())
  expiresAt DateTime
  lastActivityAt DateTime @default(now())

  @@index([userId, lastActivityAt])
  @@index([token])
}

// Журнал действий (Audit Log)
model AuditLog {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Данные действия
  action    String   // login, logout, application_sent, settings_updated, etc.
  resource  String?  // vacancyId, settingsId, etc.
  details   String?  // JSON с дополнительными деталями

  // Метаданные
  ipAddress String?
  userAgent String?
  success   Boolean  @default(true)
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

// Подписки
model Subscription {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Данные подписки
  tier      String   // free, basic, pro, ultimate
  status    String   @default("active") // active, cancelled, expired, trial

  // Оплата
  amount    Float?
  currency  String   @default("RUB")
  paymentMethod String? // stripe, paypal, etc.
  stripeSubscriptionId String? @unique
  paypalSubscriptionId String? @unique

  // Даты
  startDate DateTime @default(now())
  endDate   DateTime?
  cancelledAt DateTime?
  trialEndsAt DateTime?

  // Реферальная программа
  referralCode String? @unique
  referredBy   String? // userId who referred this user

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([referralCode])
}
